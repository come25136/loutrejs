{
  "name": "@loutrejs/example-database-drizzle-postgres",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "check": "loutre check --entry src/app.ts",
    "db:start": "docker compose up -d --wait",
    "db:stop": "docker compose down",
    "dev": "loutre dev src/app.ts --port 3002",
    "graph": "loutre graph contracts --entry src/app.ts",
    "start": "loutre start src/app.ts --port 3002",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@loutrejs/application": "0.1.0",
    "@loutrejs/core": "0.1.0",
    "@loutrejs/http": "0.1.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@loutrejs/cli": "0.1.0",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
