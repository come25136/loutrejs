{
  "name": "@loutrejs/example-database-postgres",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "loutre check --entry src/app.ts",
    "db:start": "docker compose up -d --wait",
    "db:stop": "docker compose down",
    "dev": "tsx watch src/main.ts",
    "graph": "loutre graph contracts --entry src/app.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@loutrejs/http": "0.5.0",
    "@loutrejs/loutre": "0.5.0",
    "@loutrejs/node": "0.5.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@loutrejs/cli": "0.5.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
