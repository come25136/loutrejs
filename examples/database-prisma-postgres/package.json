{
  "name": "@loutrejs/example-database-prisma-postgres",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "loutre check --entry src/app.ts",
    "db:start": "docker compose up -d --wait",
    "db:stop": "docker compose down",
    "dev": "tsx watch src/main.ts",
    "generate": "prisma generate",
    "graph": "loutre graph contracts --entry src/app.ts",
    "postinstall": "prisma generate",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@loutrejs/loutre": "0.3.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "zod": "^4.4.3",
    "@loutrejs/node": "0.3.0"
  },
  "devDependencies": {
    "@loutrejs/cli": "0.3.0",
    "prisma": "7.9.1",
    "typescript": "^7.0.2",
    "tsx": "^4.23.12"
  }
}
