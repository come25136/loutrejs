{
  "name": "@loutrejs/example-database-prisma-postgres",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "26.x" },
  "scripts": {
    "check": "loutre check --entry src/app.ts",
    "dev": "loutre dev src/app.ts --port 3003",
    "generate": "prisma generate",
    "graph": "loutre graph contracts --entry src/app.ts",
    "postinstall": "prisma generate",
    "start": "loutre start src/app.ts --port 3003",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@loutrejs/core": "0.1.0",
    "@loutrejs/database": "0.1.0",
    "@loutrejs/http": "0.1.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@loutrejs/cli": "0.1.0",
    "prisma": "7.9.1",
    "typescript": "^7.0.2"
  }
}
