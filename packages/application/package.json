    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "import": "./dist/openapi.js"
    }
  },
  "sideEffects": false,
  "publishConfig": { "access": "public", "provenance": true },
  "dependencies": {
    "@loutrejs/core": "^0.1.0",
    "@loutrejs/graph": "^0.1.0",
    "@loutrejs/http": "^0.1.0",
    "@loutrejs/runtime": "^0.1.0",
    "@loutrejs/runtime-node": "^0.1.0"
