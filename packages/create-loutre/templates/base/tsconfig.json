{
  "compilerOptions": {
    "target": "ES2024",
    "lib": [
      "ES2024",
      "DOM",
      "WebWorker.ImportScripts",
      "ScriptHost",
      "DOM.Iterable",
      "DOM.AsyncIterable",
      "ESNext.Disposable"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useDefineForClassFields": true,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": true,
    "types": "__LOUTRE_TYPES__"
  },
  "include": ["src/**/*.ts"]
}
