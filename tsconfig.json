{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useDefineForClassFields": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "skipLibCheck": true,
    "paths": {
      "@loutrejs/core": ["./packages/core/src/index.ts"],
      "@loutrejs/graph": ["./packages/graph/src/index.ts"],
      "@loutrejs/cli": ["./packages/cli/src/index.ts"],
      "@loutrejs/runtime": ["./packages/runtime/src/index.ts"],
      "@loutrejs/http": ["./packages/http/src/index.ts"],
      "@loutrejs/message-port": ["./packages/message-port/src/index.ts"],
      "@loutrejs/runtime-node": ["./packages/runtime-node/src/index.ts"]
      ,"@loutrejs/runtime-deno": ["./packages/runtime-deno/src/index.ts"]
      ,"@loutrejs/runtime-bun": ["./packages/runtime-bun/src/index.ts"]
      ,"@loutrejs/runtime-workerd": ["./packages/runtime-workerd/src/index.ts"]
      ,"@loutrejs/runtime-electron": ["./packages/runtime-electron/src/index.ts"]
      ,"@loutrejs/runtime-lambda": ["./packages/runtime-lambda/src/index.ts"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "packages/**/*.ts",
    "fixtures/**/*.ts",
    "examples/**/*.ts",
    "tests/**/*.ts",
    "conformance/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
