{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useDefineForClassFields": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "skipLibCheck": true,
    "paths": {
      "@loutrejs/loutre": ["./packages/loutre/src/index.ts"],
      "@loutrejs/loutre/host": ["./packages/loutre/src/application/host.ts"],
      "@loutrejs/loutre/binding": [
        "./packages/loutre/src/application/binding.ts"
      ],
      "@loutrejs/loutre/openapi": [
        "./packages/loutre/src/application/openapi.ts"
      ],
      "@loutrejs/loutre/presentation": [
        "./packages/loutre/src/presentation.ts"
      ],
      "@loutrejs/loutre/graph": ["./packages/loutre/src/graph/index.ts"],
      "@loutrejs/loutre/runtime": ["./packages/loutre/src/runtime/index.ts"],
      "@loutrejs/loutre/http": ["./packages/loutre/src/http/index.ts"],
      "@loutrejs/loutre/message-port": [
        "./packages/loutre/src/message-port/index.ts"
      ],
      "@loutrejs/loutre/message-port/environment": [
        "./packages/loutre/src/message-port/environment.ts"
      ],
      "@loutrejs/loutre/runtime/bun": ["./packages/loutre/src/adapters/bun.ts"],
      "@loutrejs/loutre/runtime/deno": [
        "./packages/loutre/src/adapters/deno.ts"
      ],
      "@loutrejs/loutre/runtime/cloudflare-workers": [
        "./packages/loutre/src/adapters/cloudflare-workers.ts"
      ],
      "@loutrejs/loutre/runtime/aws-lambda": [
        "./packages/loutre/src/adapters/aws-lambda.ts"
      ],
      "@loutrejs/loutre/runtime/electron": [
        "./packages/loutre/src/adapters/electron.ts"
      ],
      "@loutrejs/node": ["./packages/node/src/index.ts"],
      "@loutrejs/bullmq": ["./packages/bullmq/src/index.ts"],
      "@loutrejs/cli": ["./packages/cli/src/index.ts"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "packages/**/*.ts",
    "integrations/**/*.ts",
    "examples/**/*.ts",
    "tests/**/*.ts",
    "conformance/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "packages/create-loutre/templates/**"]
}
